<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>تسجيل الدخول</title>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700&display=swap" rel="stylesheet">
  <style>
    :root{
      --bg:#f5f7fb; --card-bg:#ffffff; --accent:#0b63d6; --muted:#6b7280;
      --input-border:#e6e9ef; --radius:14px; --shadow:0 8px 24px rgba(12,24,48,0.08); --text:#0f1724;
    }
    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0;
      font-family:'Cairo', system-ui, -apple-system, "Segoe UI", Roboto, Arial;
      background:linear-gradient(180deg,var(--bg),#eef2f8);
      color:var(--text);
      display:flex;
      align-items:center;
      justify-content:center;
      padding:32px;
    }
    .container{width:100%;max-width:420px;margin:auto}
    .card{
      background:var(--card-bg);
      border-radius:var(--radius);
      box-shadow:var(--shadow);
      padding:32px;
      border:1px solid rgba(15,23,36,0.04);
    }
    .topbar{display:flex;justify-content:flex-start;align-items:center;margin-bottom:8px}
    .lang{margin-left:auto;font-size:14px;color:var(--muted);text-decoration:none}
    .logo-wrap{display:flex;align-items:center;justify-content:center;margin:6px 0 18px}
    .logo{width:84px;height:84px;object-fit:contain;border-radius:12px;background:transparent}
    h1{text-align:center;margin:6px 0 18px;font-size:20px;font-weight:700}
    form{display:flex;flex-direction:column;gap:12px}
    label{font-size:13px;color:var(--muted);display:block;margin-bottom:6px}
    .input{width:100%;padding:12px 14px;border-radius:10px;border:1px solid var(--input-border);background:#fff;font-size:15px;color:var(--text);outline:none}
    .input:focus{border-color:var(--accent);box-shadow:0 6px 18px rgba(11,99,214,0.08)}
    .row{display:flex;justify-content:space-between;align-items:center;font-size:13px;color:var(--muted);margin-top:6px}
    .link{color:var(--accent);text-decoration:none;font-weight:600;font-size:13px}
    .btn{margin-top:8px;padding:12px;border-radius:12px;border:none;background:var(--accent);color:#fff;font-weight:700;font-size:15px;cursor:pointer;box-shadow:0 6px 18px rgba(11,99,214,0.18)}
    .secondary{margin-top:12px;text-align:center;font-size:14px;color:var(--muted)}
    .powered{margin-top:18px;text-align:center;font-size:12px;color:var(--muted);display:flex;justify-content:center;gap:8px;align-items:center}
    @media (max-width:480px){.card{padding:20px}.logo{width:72px;height:72px}}
  </style>
</head>
<body>
  <div class="container">
    <div class="card" role="main" aria-labelledby="login-title">
      <div class="topbar">
        <a class="lang" href="#" aria-label="English">الإنكليزية</a>
      </div>

      <div class="logo-wrap">
        <!-- ضع هنا سلسلة Data URL لشعارك بدلاً من DATA_URL_HERE -->
        <!-- مثال: <img src="data:image/png;base64,iVBORw0K..." alt="شعار" class="logo" /> -->
        <img src="DATA_URL_HERE" alt="شعار" class="logo" />
      </div>

      <h1 id="login-title">تسجيل الدخول</h1>

      <form action="#" method="post" autocomplete="on" novalidate>
        <div>
          <label for="email">البريد الإلكتروني</label>
          <input id="email" name="email" type="email" class="input" placeholder="example@domain.com" required />
        </div>

        <div>
          <label for="password">كلمة السر</label>
          <input id="password" name="password" type="password" class="input" placeholder="••••••••" required />
        </div>

        <div class="row" style="margin-top:6px;">
          <a class="link" href="#" id="forgot">هل نسيت كلمة المرور؟</a>
          <a class="link" href="#" id="change">تغيير كلمة المرور</a>
        </div>

        <button type="submit" class="btn">تسجيل الدخول</button>

        <div class="secondary">
          لا تملك حساب مسبقاً؟ <a class="link" href="#">إنشاء حساب</a>
        </div>

        <div class="powered">
          <span style="font-weight:600;color:var(--muted)">POWERED BY</span>
          <span style="font-size:12px;color:var(--muted)">V 2.2.1</span>
        </div>
      </form>
    </div>
  </div>
</body>
</html>
